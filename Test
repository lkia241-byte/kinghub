local function clearContent()
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") and child ~= contentLayout then
            child:Destroy()
        end
    end
end

local function addLabel(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -12, 0, 32)
    label.BackgroundTransparency = 1
    label.Text = "  " .. text
    label.TextColor3 = Theme.Gold
    label.Font = Enum.Font.GothamBold
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = content
end

local function addToggle(name)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -12, 0, 37)
    button.BackgroundColor3 = Theme.Button
    button.TextColor3 = Theme.White
    button.Font = Enum.Font.Gotham
    button.TextSize = 13
    button.Parent = content

    local function update()
        local state = enabled[name] == true
        button.Text = name .. (state and "     [ ON ]" or "     [ OFF ]")
        button.BackgroundColor3 = state and Theme.Green or Theme.Button
    end

    update()

    button.MouseButton1Click:Connect(function()
        enabled[name] = not enabled[name]
        update()
        print("[KING HUB]", name, enabled[name])
    end)
end

local function addInfo(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -12, 0, 45)
    label.BackgroundColor3 = Theme.Button
    label.TextColor3 = Theme.White
    label.Text = text
    label.TextWrapped = true
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.Parent = content
end

local function showMenu(menuName)
    currentMenu = menuName
    clearContent()
    addLabel(menuName)

    for _, item in ipairs(menus[menuName]) do
        addToggle(item)
    end

    if menuName == "AUTO FARM" then
        addInfo("Demo UI: Teleport, combat and respawn systems need authorized game logic.")
    elseif menuName == "LIVE BOSS API" then
        addInfo("Boss status: UNKNOWN - No live game API connected.")
    elseif menuName == "QUEST DATABASE" then
        addInfo("Database display requires verified game data.")
    elseif menuName == "SETTINGS" then
        addInfo("KING HUB UI settings.")
    end
end

